# Supabase 연결 후 채우기 (현재는 mock 데이터로 동작)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 승원 카드 API (생성/재생성)
CARD_API_BASE_URL=

# 카드 DB (서버 전용 — 승원 카드 API와 같은 값). 절대 NEXT_PUBLIC_ 로 시작하게 만들지 마세요.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 계정별 AI 스토리보드 채팅 (서버 전용). 비워두면 규칙 기반 기본 틀로 동작합니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 인스타 공식 API 수집 (서버 전용). 계정 주인이 발급한 장기 토큰을 계정별로 넣으세요. 이후 갱신본은 DB(ig_tokens)에 자동 저장됩니다.
IG_TOKEN_MOODIEE=
IG_TOKEN_CREAZY=
IG_TOKEN_BBAKK=
# 수집/슬랙 크론 호출 보호용 (아무 긴 임의 문자열)
CRON_SECRET=
